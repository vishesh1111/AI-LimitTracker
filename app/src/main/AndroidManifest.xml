<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required: call claude.ai endpoint over HTTPS -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required (API 33+): show reset notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ClaudeTrackerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClaudeTracker"
        android:usesCleartextTraffic="false">

        <!-- Main activity — single Compose host -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ClaudeTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Glance widget receiver -->
        <receiver
            android:name=".UsageWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Broadcast receiver for widget/notification "Refresh Now" action -->
        <receiver
            android:name=".notification.RefreshActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.claudetracker.app.ACTION_REFRESH" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
